# ==============================================================================
# UNAVULINK - ENVIRONMENT CONFIGURATION
# Copy to .env for live Supabase and external API integrations
# Note: UnavuLink runs seamlessly in realistic demo mode if keys are unset.
# ==============================================================================

# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Gemini AI Configuration (for Food Vision Understanding & Predictive Surplus)
VITE_GEMINI_API_KEY=your-gemini-api-key

# OpenStreetMap / OSRM Configuration
VITE_OSRM_API_URL=https://router.project-osrm.org
